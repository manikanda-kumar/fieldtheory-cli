#!/usr/bin/env bash
set -euo pipefail

# Install software only. Private data and user authentication belong to runtime,
# not to a reusable project snapshot.
root="$(dirname "$(dirname "$(realpath "$0")")")"
export PATH="$HOME/.local/bin:$PATH"
# The slide extraction CLI requires Node 24 or newer.
node -e 'if (Number(process.versions.node.split(".")[0]) < 24) process.exit(1)'
if ! command -v git-lfs >/dev/null || ! command -v ffmpeg >/dev/null || ! command -v tesseract >/dev/null; then
  sudo apt-get update -qq
  sudo apt-get install -y git-lfs ffmpeg tesseract-ocr
fi
if ! command -v yt-dlp >/dev/null; then
  uv tool install 'yt-dlp[default]'
fi
if ! command -v summarize >/dev/null; then
  npm install --global --prefix "$HOME/.local" --no-audit --no-fund @steipete/summarize@0.25.2
fi
npm ci --prefix "$root" --no-audit --no-fund
npm run build --prefix "$root"
