    name,
    htmlUrl: `https://github.com/${overrides.fullName}`,
    description: null,
    homepageUrl: null,
    language: null,
    topics: [],
    stargazersCount: 0,
    forksCount: 0,
    openIssuesCount: 0,
    archived: false,
    fork: false,
    defaultBranch: 'main',
    pushedAt: null,
    updatedAt: null,
    createdAt: null,
    syncedAt: overrides.starredAt,
    ...overrides,
  } as GitHubStarRecord;
}

