   200	  const results: R[] = [];
   201	  let cursor = 0;
   202	  await Promise.all(Array.from({ length: Math.min(concurrency, items.length) }, async () => {
   203	    while (cursor < items.length) {
   204	      const item = items[cursor++];
   205	      results.push(await fn(item));
   206	    }
   207	  }));
   208	  return results;
   209	}
