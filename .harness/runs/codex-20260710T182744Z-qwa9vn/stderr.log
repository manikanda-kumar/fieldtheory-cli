   169	async function readLimitedBody(response: Response, limit: number): Promise<string> {
   170	  if (!response.body) return (await response.text()).slice(0, limit);
   171	  const reader = response.body.getReader();
   172	  const chunks: Uint8Array[] = [];
   173	  let size = 0;
   174	  try {
   175	    while (size < limit) {
   176	      const { done, value } = await reader.read();
   177	      if (done) break;
   178	      const remaining = limit - size;
   179	      chunks.push(value.byteLength > remaining ? value.slice(0, remaining) : value);
   180	      size += Math.min(value.byteLength, remaining);
   181	    }
   182	  } finally {
   183	    await reader.cancel().catch(() => undefined);
   184	  }
   185	  const all = new Uint8Array(size);
   186	  let offset = 0;
   187	  for (const chunk of chunks) { all.set(chunk, offset); offset += chunk.byteLength; }
   188	  return new TextDecoder().decode(all);
   189	}
