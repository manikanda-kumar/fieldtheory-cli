   311	async function retryTransient<T>(stage: 'fetch' | 'llm', operation: () => Promise<T>): Promise<T> {
   312	  let lastError: unknown;
   313	  for (let attempt = 0; attempt < 3; attempt += 1) {
   314	    try { return await operation(); } catch (error) {
   315	      lastError = error;
   316	      if (attempt === 2 || !isTransientError(error)) throw new Error(`${stage}: ${errorMessage(error)}`);
   317	      await delay((attempt === 0 ? 1_000 : 4_000) + Math.floor(Math.random() * 250));
   318	    }
   319	  }
   320	  throw lastError;
   321	}
