   325	function isTransientError(error: unknown): boolean {
   326	  const message = (typeof error === 'string' ? error : errorMessage(error)).toLowerCase();
   327	  return /\b429\b|\b5\d\d\b|econnreset|etimedout|eai_again|aborted|aborterror|network|fetch failed|timed out|empty completion/.test(message);
   328	}
