   246	async function writeCache(entries: LinkEnrichmentEntry[]): Promise<void> {
   247	  if (entries.length === 0) return;
   248	  const dbPath = twitterBookmarksIndexPath();
   249	  const lock = await acquireDbLock(dbPath);
