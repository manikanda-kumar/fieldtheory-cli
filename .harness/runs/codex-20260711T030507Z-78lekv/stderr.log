   338	async function extractPageMaterial(url: string, fetchFn: FetchFn): Promise<string> {
   339	  const controller = new AbortController();
   340	  const timer = setTimeout(() => controller.abort(), 8_000);
   341	  try {
   342	    let current = assertSafeFetchUrl(url);
   343	    let response: Response | undefined;
   344	    // DNS rebinding protection is out of scope: validate hostname/IP literals
   345	    // before each request, while manual redirects prevent bypassing that check.
   346	    for (let redirects = 0; redirects <= 5; redirects += 1) {
   347	      response = await fetchFn(current, { redirect: 'manual', signal: controller.signal, headers: { 'User-Agent': 'Mozilla/5.0 (compatible; FieldTheoryDigest/1.0)' } });
   348	      if (!isRedirect(response.status)) break;
   349	      const location = response.headers.get('location');
   350	      await response.body?.cancel().catch(() => undefined);
   351	      if (!location || redirects === 5) throw new Error('unsafe or excessive redirect');
   352	      current = assertSafeFetchUrl(new URL(location, current).toString());
   353	    }
   354	    if (!response) throw new Error('no response');
   355	    if (!response.ok) throw new Error(`HTTP ${response.status}`);
   356	    const html = await readLimitedBody(response, BODY_LIMIT_BYTES);
   357	    const title = firstMatch(html, /<title[^>]*>([\s\S]*?)<\/title>/i);
   358	    const description = firstMatch(html, /<meta[^>]+(?:name|property)=["'](?:description|og:description)["'][^>]+content=["']([^"']*)["']/i)
   359	      ?? firstMatch(html, /<meta[^>]+content=["']([^"']*)["'][^>]+(?:name|property)=["'](?:description|og:description)["']/i);
   360	    const visible = decodeHtml(html.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, ' ').replace(/<style\b[^>]*>[\s\S]*?<\/style>/gi, ' ').replace(/<[^>]+>/g, ' ')).replace(/\s+/g, ' ').trim().slice(0, 1200);
   361	    return [`URL: ${url}`, title && `Title: ${decodeHtml(title)}`, description && `Description: ${decodeHtml(description)}`, visible && `Text: ${visible}`].filter(Boolean).join('\n');
   362	  } finally {
   363	    clearTimeout(timer);
   364	  }
   365	}
