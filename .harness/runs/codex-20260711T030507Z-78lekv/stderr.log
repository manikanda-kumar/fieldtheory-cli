   426	async function mapConcurrent<T, R>(items: T[], concurrency: number, fn: (item: T) => Promise<R>): Promise<R[]> {
   427	  const results: R[] = [];
   428	  let cursor = 0;
   429	  await Promise.all(Array.from({ length: Math.min(concurrency, items.length) }, async () => {
   430	    while (cursor < items.length) {
   431	      const item = items[cursor++];
   432	      results.push(await fn(item));
   433	    }
   434	  }));
   435	  return results;
   436	}
