   189	async function enrichEligibleItems(
   190	  eligible: CanonicalRecentItem[],
   191	  cached: Map<string, LinkEnrichmentEntry>,
   192	  options: EnrichThinItemsOptions,
   193	  now: Date,
   194	  limit: number,
   195	  onProgress?: (result: { attempted: number; ok: number; failed: number }) => void,
   196	  concurrency = DAILY_DEFAULT_CONCURRENCY,
   197	  retryFailed = false,
   198	): Promise<LinkEnrichmentEntry[]> {
   199	  const misses = eligible.filter((item) => shouldAttempt(item.canonicalUrl!, cached.get(item.canonicalUrl!), now, retryFailed)).slice(0, limit);
   200	  const fetchFn = options.fetch ?? globalThis.fetch.bind(globalThis);
   201	  const llm = options.llm ?? (async (prompt: string) => (await createOpenCodeClient().chat({ prompt, maxTokens: 2000 })).text);
   202	  let attempted = 0;
   203	  let ok = 0;
   204	  let failed = 0;
   205	  const enrichOne = async (item: CanonicalRecentItem): Promise<LinkEnrichmentEntry> => {
   206	    const url = item.canonicalUrl!;
   207	    let update: LinkEnrichmentEntry;
   208	    try {
   209	      const material = await retryTransient('fetch', () => extractPageMaterial(url, fetchFn));
   210	      await delay(250);
   211	      const summary = await retryTransient('llm', async () => {
   212	        const value = (await llm(buildEnrichmentPrompt(material))).trim();
   213	        if (!value) throw new Error('empty completion');
   214	        return value;
   215	      });
   216	      update = { url, summary, status: 'ok', enrichedAt: now.toISOString(), error: null };
   217	    } catch (error) {
   218	      update = { url, summary: null, status: 'failed', enrichedAt: now.toISOString(), error: formatFailure(error) };
   219	    }
   220	    attempted += 1;
   221	    if (update.status === 'ok') ok += 1;
   222	    else failed += 1;
   223	    if (onProgress && attempted % 25 === 0) onProgress({ attempted, ok, failed });
   224	    return update;
   225	  };
   226	  const updates: LinkEnrichmentEntry[] = [];
   227	  for (let start = 0; start < misses.length; start += 50) {
   228	    const batch = await mapConcurrent(misses.slice(start, start + 50), concurrency, enrichOne);
   229	    await writeCache(batch);
   230	    updates.push(...batch);
   231	  }
   232	  for (const update of updates) if (update.status === 'ok' && update.summary) cached.set(update.url, update);
   233	  return updates;
   234	}
