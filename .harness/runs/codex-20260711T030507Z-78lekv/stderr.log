    23	function getSql(): Promise<SqlJsStatic> {
    24	  if (!sqlPromise) {
    25	    const initSqlJs = require('sql.js-fts5') as (opts: any) => Promise<SqlJsStatic>;
    26	    const wasmPath = require.resolve('sql.js-fts5/dist/sql-wasm.wasm');
    27	    const wasmBinary = fs.readFileSync(wasmPath);
    28	    sqlPromise = initSqlJs({ wasmBinary });
    29	  }
    30	  return sqlPromise!;
    31	}
    32	
    33	export async function openDb(filePath: string): Promise<Database> {
    34	  const SQL = await getSql();
    35	  if (fs.existsSync(filePath)) {
    36	    const buf = fs.readFileSync(filePath);
    37	    return new SQL.Database(buf);
    38	  }
    39	  return new SQL.Database();
    40	}
    41	
    42	export async function createDb(): Promise<Database> {
    43	  const SQL = await getSql();
    44	  return new SQL.Database();
    45	}
    46	
    47	export function saveDb(db: Database, filePath: string): void {
    48	  const dir = path.dirname(filePath);
    49	  if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
    50	  const data = db.export();
    51	  const tmp = `${filePath}.${process.pid}.${Date.now()}.${Math.random().toString(16).slice(2)}.tmp`;
    52	
    53	  // Crash-durable write: openSync → writeSync → fsyncSync → close → rename → fsync parent dir.
    54	  // On power loss, the target file either has the old content or the full new content —
    55	  // never a zero-byte or partially-written bookmarks.db.
    56	  const fd = fs.openSync(tmp, 'w', 0o600);
    57	  try {
    58	    fs.writeSync(fd, Buffer.from(data));
    59	    fs.fsyncSync(fd);
    60	  } finally {
    61	    fs.closeSync(fd);
    62	  }
    63	  fs.renameSync(tmp, filePath);
    64	
    65	  try {
    66	    const dirFd = fs.openSync(dir, 'r');
    67	    try {
    68	      fs.fsyncSync(dirFd);
    69	    } finally {
    70	      fs.closeSync(dirFd);
    71	    }
    72	  } catch {
    73	    // Windows can't open a dir for fsync — the file fsync above is the critical guarantee.
    74	  }
    75	}
    76	
    77	export async function acquireDbLock(filePath: string, options: DbLockOptions = {}): Promise<DbLock> {
    78	  const lockPath = `${filePath}.lock`;
    79	  const staleAfterMs = options.staleAfterMs ?? LOCK_STALE_MS;
    80	  const timeoutMs = options.timeoutMs ?? LOCK_TIMEOUT_MS;
    81	  const pollIntervalMs = options.pollIntervalMs ?? LOCK_POLL_MS;
    82	  const deadline = Date.now() + timeoutMs;
    83	  fs.mkdirSync(path.dirname(filePath), { recursive: true });
    84	
    85	  while (true) {
    86	    try {
    87	      const fd = fs.openSync(lockPath, 'wx', 0o600);
    88	      try {
    89	        fs.writeFileSync(fd, JSON.stringify({ pid: process.pid, createdAt: new Date().toISOString() }));
    90	        fs.fsyncSync(fd);
    91	      } finally {
    92	        fs.closeSync(fd);
    93	      }
    94	      return { path: lockPath };
    95	    } catch (error) {
    96	      if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;
    97	      if (isStaleLock(lockPath, staleAfterMs)) {
    98	        console.warn(`Stealing stale database lock: ${lockPath}`);
    99	        try { fs.unlinkSync(lockPath); } catch (unlinkError) {
   100	          if ((unlinkError as NodeJS.ErrnoException).code !== 'ENOENT') throw unlinkError;
   101	        }
   102	        continue;
   103	      }
   104	      if (Date.now() >= deadline) throw new Error(`Timed out waiting for database lock: ${lockPath}`);
   105	      await new Promise<void>((resolve) => setTimeout(resolve, pollIntervalMs));
   106	    }
   107	  }
   108	}
   109	
   110	export function releaseDbLock(lock: DbLock): void {
   111	  try {
   112	    fs.unlinkSync(lock.path);
   113	  } catch (error) {
   114	    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
   115	  }
   116	}
   117	
   118	function isStaleLock(lockPath: string, staleAfterMs: number): boolean {
   119	  try {
   120	    return Date.now() - fs.statSync(lockPath).mtimeMs > staleAfterMs;
   121	  } catch (error) {
   122	    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return false;
   123	    throw error;
   124	  }
   125	}
