   371	async function readLimitedBody(response: Response, limit: number): Promise<string> {
   372	  // A no-body response has no bytes to read; never fall back to response.text(),
   373	  // which may buffer an unbounded body in nonstandard fetch implementations.
   374	  if (!response.body) return '';
   375	  const reader = response.body.getReader();
   376	  const chunks: Uint8Array[] = [];
   377	  let size = 0;
   378	  try {
   379	    while (size < limit) {
   380	      const { done, value } = await reader.read();
   381	      if (done) break;
   382	      const remaining = limit - size;
   383	      chunks.push(value.byteLength > remaining ? value.slice(0, remaining) : value);
   384	      size += Math.min(value.byteLength, remaining);
   385	    }
   386	  } finally {
   387	    await reader.cancel().catch(() => undefined);
   388	  }
   389	  const all = new Uint8Array(size);
   390	  let offset = 0;
   391	  for (const chunk of chunks) { all.set(chunk, offset); offset += chunk.byteLength; }
   392	  return new TextDecoder().decode(all);
   393	}
