   395	function assertSafeFetchUrl(value: string): string {
   396	  const url = new URL(value);
   397	  if (url.protocol !== 'http:' && url.protocol !== 'https:') throw new Error('unsupported URL scheme');
   398	  const hostname = url.hostname.toLowerCase().replace(/^\[|\]$/g, '');
   399	  if (hostname === 'localhost' || hostname.endsWith('.local') || isPrivateIpLiteral(hostname)) {
   400	    throw new Error('unsafe fetch host');
   401	  }
   402	  return url.toString();
   403	}
   404	
   405	function isPrivateIpLiteral(hostname: string): boolean {
   406	  const octets = hostname.split('.');
   407	  if (octets.length === 4 && octets.every((part) => /^\d+$/.test(part) && Number(part) <= 255)) {
   408	    const [a, b] = octets.map(Number);
   409	    return a === 0 || a === 10 || a === 127 || (a === 169 && b === 254) || (a === 172 && b >= 16 && b <= 31) || (a === 192 && b === 168);
   410	  }
   411	  return hostname === '::' || hostname === '::1' || /^[fcfd][0-9a-f]{1,3}:/i.test(hostname);
   412	}
