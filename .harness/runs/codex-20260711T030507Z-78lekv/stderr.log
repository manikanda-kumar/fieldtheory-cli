   332	  for (const entry of entries) if (entry.status === 'failed' && entry.error) counts.set(entry.error, (counts.get(entry.error) ?? 0) + 1);
   333	  return [...counts].sort((a, b) => b[1] - a[1]).slice(0, 3).map(([error, count]) => ({ error, count }));
   334	}
