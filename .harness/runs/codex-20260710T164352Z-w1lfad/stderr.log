+export interface DailyCoverageCounts {
+  collected: number;
+  themed: number;
+  alsoSaved: number;
+  carriedOver: number;
+  citationsDropped: number;
+  /** Counted across the full canonical index, not just this digest window. */
+  undateableExcluded: number;
+  synthesis: 'llm' | 'mechanical';
+}
