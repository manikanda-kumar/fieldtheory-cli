  if (override) return override;
  const canonical = path.join(os.homedir(), '.fieldtheory', 'bookmarks');
  const legacy = path.join(os.homedir(), '.ft-bookmarks');
  if (fs.existsSync(canonical) || !fs.existsSync(legacy)) return canonical;
  return legacy;
