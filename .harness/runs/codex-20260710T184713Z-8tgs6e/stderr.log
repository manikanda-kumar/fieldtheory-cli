    apiKey: 'test-key',
    fetch: async () => new Response(JSON.stringify({ choices: [{ message: { reasoning_content: 'private reasoning', content: '' } }] })),
  });
  await assert.rejects(() => client.chat({ prompt: 'summarize' }), OpenCodeRequestError);
});
