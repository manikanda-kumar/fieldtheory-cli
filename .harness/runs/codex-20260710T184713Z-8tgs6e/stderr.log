+    });
+    assert.equal(result.enrichedCount, 0);
+
+    let retried = false;
+    const cachedFailure = await enrichThinItems([item], {
+      fetch: async () => { retried = true; throw new Error('should remain cached failed'); },
+      llm: async () => { retried = true; return 'should not run'; },
