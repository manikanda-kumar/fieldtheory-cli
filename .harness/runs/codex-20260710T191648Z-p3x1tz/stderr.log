+async function enrichEligibleItems(
+  eligible: CanonicalRecentItem[],
+  cached: Map<string, LinkEnrichmentEntry>,
+  options: EnrichThinItemsOptions,
+  now: Date,
+  limit: number,
+  onProgress?: (result: { attempted: number; ok: number; failed: number }) => void,
