+function parseSources(value: unknown): string[] {
+  if (typeof value !== 'string') return [];
+  try {
+    const parsed = JSON.parse(value);
+    return Array.isArray(parsed) ? parsed.filter((source): source is string => typeof source === 'string') : [];
+  } catch {
+    return [];
+  }
+}
