        return new Response('', { status: 302, headers: { location: 'http://127.0.0.1/internal' } });
      },
      llm: async () => 'unused',
    });
    assert.equal(redirectResult.enrichedCount, 0);
    assert.equal(fetchCalls, 1);
  });
});

